" Shortcut jk for <esc>
:inoremap jk <esc>

" Enable syntax highlighting and set color scheme
syntax on
colorscheme badwolf

" Show ruler, status line, line numbers, ...
set ruler laststatus=2 number title hlsearch

" Disable swap file
set noswapfile

" Use Unix file format
set fileformat=unix

" Disable bell
set belloff=all
